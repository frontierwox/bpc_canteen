# ═══════════════════════════════════════════════════════════════════════════════
# BPC Canteen — Client Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in values for your environment.
# In production (Vercel), set these in Dashboard → Settings → Environment Variables.

# Base URL for the BPC Canteen API
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Production (set in Vercel Dashboard):
# VITE_API_BASE_URL=https://your-api-domain.vercel.app/api/v1

# Application display name
VITE_APP_NAME=BPC Canteen
